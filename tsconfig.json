{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "aibot.ts",
    "livebot.ts",
    "ReplayExtractor.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
