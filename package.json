{
  "name": "openfrontai",
  "version": "1.0.0",
  "description": "Protocol-correct OpenFront strategy bot with ONNX-assisted spawning and live-stat combat decisions",
  "main": "aibot.ts",
  "scripts": {
    "bot": "tsx aibot.ts",
    "bot:legacy-entry": "tsx livebot.ts",
    "extract": "tsx ReplayExtractor.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "openfront",
    "ai",
    "strategy",
    "onnx"
  ],
  "author": "Samuel Gu",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "onnxruntime-node": "^1.24.3",
    "playwright": "^1.59.1",
    "puppeteer": "^24.40.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
